{
  "id": "sulang-core-support",
  "name": "SuLang 核心支持库",
  "version": "1.0.0",
  "manifest_version": 2,
  "api_version": "1.0.0",
  "ide_version": ">=0.1,<1.0",
  "abi": "source",
  "author": "SuLang IDE",
  "description": "提供文本、字节集、数值、时间、文件、磁盘、网络及 Windows 系统基础能力。",
  "kind": "static",
  "capabilities": [
    "symbol_categories"
  ],
  "header_categories": {
    "include/variables.h": "变量操作",
    "include/constants.h": "常量",
    "include/debug.h": "程序调试",
    "include/disk.h": "磁盘操作",
    "include/environment.h": "环境读取",
    "include/console.h": "控制台操作",
    "include/media.h": "媒体播放",
    "include/pinyin.h": "拼音处理",
    "include/other.h": "其他",
    "include/datetime.h": "时间操作",
    "include/numeric.h": "数值转换",
    "include/arrays.h": "数组操作",
    "include/network.h": "网络通讯",
    "include/text.h": "文本操作",
    "include/file.h": "文件读写",
    "include/system.h": "系统处理",
    "include/bytes.h": "字节集操作"
  },
  "systems": [
    "windows-x64",
    "windows-x86"
  ],
  "toolchains": [
    "msvc",
    "mingw"
  ],
  "configurations": [
    "Debug",
    "Release",
    "RelWithDebInfo",
    "MinSizeRel"
  ],
  "files": [
    "include/variables.h",
    "include/constants.h",
    "include/debug.h",
    "include/disk.h",
    "include/environment.h",
    "include/console.h",
    "include/media.h",
    "include/pinyin.h",
    "include/other.h",
    "include/datetime.h",
    "include/numeric.h",
    "include/arrays.h",
    "include/network.h",
    "include/text.h",
    "include/file.h",
    "include/system.h",
    "include/bytes.h",
    "include/types.h",
    "src/text.cpp",
    "src/bytes.cpp",
    "src/numeric.cpp",
    "src/time.cpp",
    "src/environment.cpp",
    "src/disk.cpp",
    "src/network.cpp",
    "src/system.cpp",
    "src/debug.cpp",
    "src/console.cpp",
    "src/media.cpp",
    "src/other.cpp",
    "src/file.cpp",
    "src/constants.cpp",
    "src/variables.cpp",
    "src/arrays.cpp",
    "src/pinyin.cpp",
    "README.md"
  ],
  "headers": [
    "include/variables.h",
    "include/constants.h",
    "include/debug.h",
    "include/disk.h",
    "include/environment.h",
    "include/console.h",
    "include/media.h",
    "include/pinyin.h",
    "include/other.h",
    "include/datetime.h",
    "include/numeric.h",
    "include/arrays.h",
    "include/network.h",
    "include/text.h",
    "include/file.h",
    "include/system.h",
    "include/bytes.h"
  ],
  "sources": [
    "src/text.cpp",
    "src/bytes.cpp",
    "src/numeric.cpp",
    "src/time.cpp",
    "src/environment.cpp",
    "src/disk.cpp",
    "src/network.cpp",
    "src/system.cpp",
    "src/debug.cpp",
    "src/console.cpp",
    "src/media.cpp",
    "src/other.cpp",
    "src/file.cpp",
    "src/constants.cpp",
    "src/variables.cpp",
    "src/arrays.cpp",
    "src/pinyin.cpp"
  ],
  "include_dirs": [
    "include"
  ],
  "library_dirs": [],
  "libraries": [
    "ws2_32",
    "iphlpapi",
    "winmm",
    "user32",
    "shell32",
    "gdi32",
    "advapi32"
  ],
  "runtime_files": [],
  "compile_definitions": [
    "SULANG_CORE_SUPPORT=1",
    "NOMINMAX"
  ],
  "dependencies": [],
  "documentation": "README.md"
}
